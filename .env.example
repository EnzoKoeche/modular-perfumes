# Copie para .env e ajuste. O .env nunca vai para o GitHub.

# Chave para assinar a sessão (troque por um texto longo e aleatório)
SECRET_KEY=troque-por-um-texto-aleatorio

# Banco MySQL (os valores abaixo batem com o docker-compose.yml, só para uso local)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=modular
MYSQL_PASSWORD=modular_dev
MYSQL_DATABASE=modular_perfumes

# Catálogo: "exemplo" usa perfumes fictícios de app/catalogo_exemplo.json (sem gastar cota)
#           "fragella" usa a API real e exige FRAGELLA_API_KEY
CATALOGO_PROVEDOR=fragella
FRAGELLA_API_KEY=5152aa28ef7638b03265772dcd7e32cd1d1f24885f5a2c222b70509845f423bc

# Consultor de IA (2ª Sprint): chave da API da Anthropic, modelo e esforço
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5
IA_ESFORCO=medium

# Produção (Vercel + MySQL na nuvem): certificado da CA do banco em texto e cookie só em HTTPS
MYSQL_SSL_CA=
SESSION_COOKIE_SECURE=0

digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.45, ranksep=0.42, pad=0.4, dpi=200, fontname="Helvetica", labelloc=t, label=<<FONT POINT-SIZE="22"><B>ARTEFATO 8.2 — Diagrama de Atividades: Administrador mantém os pesos das alternativas (US6)</B></FONT><BR/><FONT POINT-SIZE="13">● início   ◉ fim   ◇ decisão   □ ação (a cor indica quem executa)</FONT><BR/> >];
  node [fontname="Helvetica", fontsize=13, shape=box, style="rounded,filled", fillcolor="#E8F0FB", color="#5B6B8C", penwidth=1.4, margin="0.18,0.08"];
  edge [fontname="Helvetica", fontsize=12, color="#44516B", arrowsize=0.8, penwidth=1.3];
  inicio [shape=circle, label="", width=0.3, style=filled, fillcolor=black];
  legenda [shape=plaintext, style="", label=<<TABLE BORDER="0" CELLSPACING="6"><TR><TD BGCOLOR="#EAF5EA" BORDER="1" COLOR="#5B6B8C">  Administrador  </TD><TD BGCOLOR="#E8F0FB" BORDER="1" COLOR="#5B6B8C">  Sistema (Flask + MySQL)  </TD></TR></TABLE>>];
  b1 [label="Entrar como administrador", fillcolor="#EAF5EA"];
  b2 [label="Abrir \"Questionário\" e\nacionar \"Pesos\" de uma pergunta", fillcolor="#EAF5EA"];
  b3 [label="Mostrar a tabela alternativa × família\ncom os pesos atuais", fillcolor="#E8F0FB"];
  b4 [label="Informar os pesos e\nacionar \"Salvar pesos\"", fillcolor="#EAF5EA"];
  c1 [shape=diamond, style=filled, fillcolor="#FFFBEA", color="#B08900", label="Todos inteiros\nde 0 a 10?", fontsize=12, margin="0.05,0.03"];
  f1 [label="Não gravar nada e exibir\n\"Use pesos inteiros de 0 a 10\"\n(US6 CA2)", fillcolor="#E8F0FB"];
  b5 [label="Apagar os pesos da pergunta e\ngravar os maiores que zero", fillcolor="#E8F0FB"];
  b6 [label="Exibir \"Pesos atualizados\"\n(US6 CA1)", fillcolor="#E8F0FB"];
  c2 [shape=diamond, style=filled, fillcolor="#FFFBEA", color="#B08900", label="Alguma alternativa\nficou toda em 0?", fontsize=12, margin="0.05,0.03"];
  f2 [label="Avisar que a alternativa não soma\nafinidade com nenhuma família\n(US6 CA3)", fillcolor="#E8F0FB"];
  fim [shape=doublecircle, label="", width=0.22, style=filled, fillcolor=black];
  { rank=same; c1; f1; }
  { rank=same; c2; f2; }
  legenda -> inicio [style=invis];
  inicio -> b1 -> b2 -> b3 -> b4 -> c1;
  c1 -> f1 [xlabel="não "]; f1 -> b4 [constraint=false];
  c1 -> b5 [xlabel="sim "]; b5 -> b6 -> c2;
  c2 -> f2 [xlabel="sim "]; f2 -> fim;
  c2 -> fim [xlabel="não "];
}
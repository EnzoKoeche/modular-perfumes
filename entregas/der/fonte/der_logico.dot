    diretriz_agente [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>diretriz_agente</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">titulo</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(120) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">conteudo</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">ordem</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">SMALLINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">ativa</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TINYINT(1) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">atualizada_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATETIME NN</FONT></TD></TR></TABLE>>];

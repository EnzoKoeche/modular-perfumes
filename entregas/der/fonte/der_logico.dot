digraph DER {
  graph [rankdir=LR, splines=spline, nodesep=0.55, ranksep=1.1, pad=0.5, dpi=220, fontname="Helvetica", bgcolor="white", newrank=true, label=<<BR/><FONT POINT-SIZE="26"><B>MODULAR PERFUMES — Diagrama de Entidade e Relacionamento (Lógico) — visão completa</B></FONT><BR/><FONT POINT-SIZE="17">PK = Chave Primária   |   FK = Chave Estrangeira   |   U = UNIQUE   |   NN = NOT NULL   |   U¹ = UNIQUE composto   |   Pé-de-galinha: traço duplo = exatamente um  ·  traço + círculo = zero ou um  ·  pé + círculo = zero ou muitos</FONT>>, labelloc=b];
  node [shape=plaintext, fontname="Helvetica", fontsize=13];
  edge [color="#2F4A7A", penwidth=1.6, arrowsize=1.1, dir=both];
  subgraph cluster_acesso {
    label=<<B>ACESSO</B>>; fontsize=18; fontcolor="#555555"; style="rounded,dashed"; color="#9A9A9A"; margin=18;
    usuario [label=<<TABLE BORDER="1" COLOR="#A64500" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#A64500" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(80) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>U</B></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(120) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">senha_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">perfil</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">ENUM(CLIENTE,LOJISTA,ADMIN) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">ativo</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TINYINT(1) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">tentativas_login</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TINYINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">bloqueado_ate</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATETIME NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">aceite_termos_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATETIME NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">criado_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATETIME NN</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_questionario {
    label=<<B>QUESTIONÁRIO E PERFIL OLFATIVO</B>>; fontsize=18; fontcolor="#555555"; style="rounded,dashed"; color="#9A9A9A"; margin=18;
    questionario [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>questionario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">titulo</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(120) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">ativo</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TINYINT(1) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">criado_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATETIME NN</FONT></TD></TR></TABLE>>];
    pergunta [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>pergunta</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>FK</B></TD><TD ALIGN="LEFT">questionario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">enunciado</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">ENUM(UNICA,MULTIPLA) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">ordem</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">SMALLINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">obrigatoria</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TINYINT(1) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">ativa</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TINYINT(1) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">atualizada_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATETIME NN</FONT></TD></TR></TABLE>>];
    alternativa [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>alternativa</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>FK</B></TD><TD ALIGN="LEFT">pergunta_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">texto</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(150) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">ordem</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">SMALLINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">ativa</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TINYINT(1) NN</FONT></TD></TR></TABLE>>];
    alternativa_peso [label=<<TABLE BORDER="1" COLOR="#385723" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#385723" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>alternativa_peso</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK,FK</B></TD><TD ALIGN="LEFT">alternativa_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK,FK</B></TD><TD ALIGN="LEFT">familia_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">peso</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DECIMAL(4,2) NN</FONT></TD></TR></TABLE>>];
    resposta_questionario [label=<<TABLE BORDER="1" COLOR="#A64500" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#A64500" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>resposta_questionario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>FK</B></TD><TD ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>FK</B></TD><TD ALIGN="LEFT">questionario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">iniciada_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATETIME NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">concluida_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATETIME NULL</FONT></TD></TR></TABLE>>];
    resposta_item [label=<<TABLE BORDER="1" COLOR="#385723" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#385723" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>resposta_item</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK,FK</B></TD><TD ALIGN="LEFT">resposta_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK,FK</B></TD><TD ALIGN="LEFT">pergunta_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK,FK</B></TD><TD ALIGN="LEFT">alternativa_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">respondida_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATETIME NN</FONT></TD></TR></TABLE>>];
    perfil_olfativo [label=<<TABLE BORDER="1" COLOR="#A64500" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#A64500" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>perfil_olfativo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>FK,U</B></TD><TD ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>FK</B></TD><TD ALIGN="LEFT">resposta_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">nivel_conhecimento</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">ENUM(INICIANTE,INTERMEDIARIO,AVANCADO) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">gerado_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATETIME NN</FONT></TD></TR></TABLE>>];
    perfil_familia [label=<<TABLE BORDER="1" COLOR="#385723" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#385723" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>perfil_familia</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK,FK</B></TD><TD ALIGN="LEFT">perfil_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK,FK</B></TD><TD ALIGN="LEFT">familia_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">afinidade</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DECIMAL(5,2) NN</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_catalogo {
    label=<<B>CATÁLOGO (IMPORTADO DA API)</B>>; fontsize=18; fontcolor="#555555"; style="rounded,dashed"; color="#9A9A9A"; margin=18;
    marca [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>marca</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>U</B></TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(80) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">pais</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(60) NULL</FONT></TD></TR></TABLE>>];
    familia_olfativa [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>familia_olfativa</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>U</B></TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(50) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">descricao</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(255) NULL</FONT></TD></TR></TABLE>>];
    nota_olfativa [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>nota_olfativa</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>U</B></TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(80) NN</FONT></TD></TR></TABLE>>];
    acorde [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>acorde</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>U</B></TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(60) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>FK</B></TD><TD ALIGN="LEFT">familia_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NULL</FONT></TD></TR></TABLE>>];
    perfume [label=<<TABLE BORDER="1" COLOR="#A64500" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#A64500" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>perfume</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>U</B></TD><TD ALIGN="LEFT">api_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(64) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>FK</B></TD><TD ALIGN="LEFT">marca_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(150) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">genero</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">ENUM(MASCULINO,FEMININO,UNISSEX) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">ano</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">SMALLINT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">imagem_url</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(500) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">fixacao</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(40) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">projecao</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(40) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">descricao</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">visivel</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TINYINT(1) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">campos_revisados</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">JSON NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">importado_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATETIME NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">atualizado_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATETIME NN</FONT></TD></TR></TABLE>>];
    perfume_nota [label=<<TABLE BORDER="1" COLOR="#385723" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#385723" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>perfume_nota</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK,FK</B></TD><TD ALIGN="LEFT">perfume_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK,FK</B></TD><TD ALIGN="LEFT">nota_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK</B></TD><TD ALIGN="LEFT">nivel</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">ENUM(SAIDA,CORPO,FUNDO) NN</FONT></TD></TR></TABLE>>];
    perfume_acorde [label=<<TABLE BORDER="1" COLOR="#385723" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#385723" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>perfume_acorde</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK,FK</B></TD><TD ALIGN="LEFT">perfume_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK,FK</B></TD><TD ALIGN="LEFT">acorde_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">intensidade</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(20) NULL</FONT></TD></TR></TABLE>>];
    importacao_catalogo [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>importacao_catalogo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">origem</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">ENUM(MANUAL,AGENDADA) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">ENUM(EM_ANDAMENTO,CONCLUIDA,FALHOU) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">qtd_incluidos</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">qtd_atualizados</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">mensagem_erro</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">iniciada_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATETIME NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">finalizada_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATETIME NULL</FONT></TD></TR></TABLE>>];

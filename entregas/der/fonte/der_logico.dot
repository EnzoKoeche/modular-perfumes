    mensagem [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="15"><B>mensagem</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"><B>FK</B></TD><TD ALIGN="LEFT">conversa_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">papel</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">ENUM(USUARIO,ASSISTENTE) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">conteudo_json</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">JSON NN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">modelo</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(40) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">tokens_entrada</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">tokens_saida</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">tokens_cache</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="46"> </TD><TD ALIGN="LEFT">enviada_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATETIME NN</FONT></TD></TR></TABLE>>];
